# Step Plan (OpenAI-compatible). Do NOT use https://api.stepfun.com/v1 for a Plan key.
OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
AGENTMED_MODEL=step-3.7-flash
STEP_API_KEY=
OPENAI_API_KEY=

# Live run fails unless AgentTeams, Langfuse, Step Plan, Gate, and GitHub are up.
REQUIRE_LIVE=true
KERNEL_API_HOST=127.0.0.1
KERNEL_API_PORT=8088

# Langfuse (docker compose in ~/langfuse, UI http://localhost:3001)
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local-ai-drama
LANGFUSE_SECRET_KEY=sk-lf-local-ai-drama

DATABASE_URL=sqlite:///./data/agentmed.db
AGENTMED_DATA_DIR=./data

# AgentTeams non-interactive install
AGENTTEAMS_NON_INTERACTIVE=1
AGENTTEAMS_VERSION=v1.2.2
AGENTTEAMS_LLM_PROVIDER=openai-compat
AGENTTEAMS_OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
AGENTTEAMS_DEFAULT_MODEL=step-3.7-flash
AGENTTEAMS_EMBEDDING_MODEL=
AGENTTEAMS_ADMIN_PASSWORD=agentmed-admin
AGENTTEAMS_MANAGER_RUNTIME=copaw
AGENTTEAMS_DEFAULT_WORKER_RUNTIME=copaw
AGENTTEAMS_PORT_ELEMENT_WEB=18088
AGENTTEAMS_PORT_GATEWAY=18080
AGENTTEAMS_PORT_DASHBOARD=13000
AGENTTEAMS_GATEWAY=http://127.0.0.1:18080
AGENTTEAMS_ELEMENT=http://127.0.0.1:18088
AGENTTEAMS_DASHBOARD=http://127.0.0.1:13000
